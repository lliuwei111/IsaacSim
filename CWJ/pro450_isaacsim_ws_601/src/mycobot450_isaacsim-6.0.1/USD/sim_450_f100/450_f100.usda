def Xform "mycobot_pro450" (
    prepend references = @../mycobot_pro_450/payloads/base.usda@
    variants = {
        string Gripper = "base"
        string Physics = "physx"
    }
    prepend variantSets = "Gripper"
    append variantSets = "Physics"
)
{
    over "Geometry" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001

        over "base_link"
        {
            rel physics:simulationOwner
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Link1"
            {
                rel physics:simulationOwner

                over "Link2"
                {
                    rel physics:simulationOwner

                    over "Link3"
                    {
                        rel physics:simulationOwner

                        over "Link4"
                        {
                            rel physics:simulationOwner

                            over "Link5"
                            {
                                rel physics:simulationOwner

                                over "Link6"
                                {
                                    rel physics:simulationOwner
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "joint1"
        {
            float drive:angular:physics:damping = 50
            float drive:angular:physics:stiffness = 500000
            float drive:angular:physics:targetPosition = 0.1
            bool[] isaac:actuator (
                displayName = "Actuator"
            )
            string isaac:NameOverride (
                displayName = "Joint Name Override"
            )
            token[] isaac:physics:DofOffsetOpOrder (
                displayName = "Dof Offset Op Order"
            )
            float physics:lowerLimit = -162
            float physics:upperLimit = 162
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float drive:angular:physics:damping = 50
            float drive:angular:physics:stiffness = 500000
