"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mycobot_pro450" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </mycobot_pro450/Physics/root_joint>,
        </mycobot_pro450/Physics/joint1>,
        </mycobot_pro450/Physics/joint2>,
        </mycobot_pro450/Physics/joint3>,
        </mycobot_pro450/Physics/joint4>,
        </mycobot_pro450/Physics/joint5>,
        </mycobot_pro450/Physics/joint6>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </mycobot_pro450/Geometry/base_link>,
        </mycobot_pro450/Geometry/base_link/Link1>,
        </mycobot_pro450/Geometry/base_link/Link1/Link2>,
        </mycobot_pro450/Geometry/base_link/Link1/Link2/Link3>,
        </mycobot_pro450/Geometry/base_link/Link1/Link2/Link3/Link4>,
        </mycobot_pro450/Geometry/base_link/Link1/Link2/Link3/Link4/Link5>,
        </mycobot_pro450/Geometry/base_link/Link1/Link2/Link3/Link4/Link5/Link6>,
    ]
    token isaac:robotType = "Manipulator"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "Link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "Link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
