#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mycobot_pro450"
    doc = """Generated from Composed Stage of root layer /tmp/tmpnfhc_0fh/mycobot_pro450.usdc


