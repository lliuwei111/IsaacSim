#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mygripper_f100"
    doc = """Generated from Composed Stage of root layer /tmp/tmpwiprm2fu/mygripper_f100.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mygripper_f100_n2nz5pur/usdex_mygripper_f100/mygripper_f100.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mygripper_f100_n2nz5pur/temp_mygripper_f100/mygripper_f100.usd


Generated from Composed Stage of root layer /home/elephant/mycobot450_isaacsim/USD/mygripper_f100/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "mygripper_f100"
{
    over "Physics"
    {
        over "joint2_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint3_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxMimicJoint:rotX:dampingRatio = 0.005
            float physxMimicJoint:rotX:gearing = 1
            float physxMimicJoint:rotX:naturalFrequency = 2500
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </mygripper_f100/Physics/joint2_left_joint>
            uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
        }

        over "joint1_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxMimicJoint:rotX:dampingRatio = 0.005
            float physxMimicJoint:rotX:gearing = -1
            float physxMimicJoint:rotX:naturalFrequency = 2500
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </mygripper_f100/Physics/joint2_left_joint>
            uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
        }

        over "joint2_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxMimicJoint:rotX:dampingRatio = 0.005
            float physxMimicJoint:rotX:gearing = 1
            float physxMimicJoint:rotX:naturalFrequency = 2500
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </mygripper_f100/Physics/joint2_left_joint>
            uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
        }

        over "joint3_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxMimicJoint:rotX:dampingRatio = 0.005
            float physxMimicJoint:rotX:gearing = -1
            float physxMimicJoint:rotX:naturalFrequency = 2500
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </mygripper_f100/Physics/joint2_left_joint>
            uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
        }

        over "joint1_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxMimicJoint:rotX:dampingRatio = 0.005
            float physxMimicJoint:rotX:gearing = 1
            float physxMimicJoint:rotX:naturalFrequency = 2500
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </mygripper_f100/Physics/joint2_left_joint>
            uniform token physxMimicJoint:rotX:referenceJointAxis = "rotZ"
        }
    }
}

